<?xml version="1.0" encoding="UTF-8"?>
<!--
  HitchWise launch screen: the language screen's dusk gradient, a glass circle with a thumbs-up and the name.
  SplashView (Shared/Components/SplashView.swift) starts from exactly this layout and animates into the app,
  so keep the sizes and offsets of both in step:
    circle 112 x 112, centre 28 pt above the screen centre; thumbs-up 46 pt bold;
    "HitchWise" system heavy 44 pt, centre 74 pt below the screen centre.
-->
