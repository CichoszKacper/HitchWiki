.Trashes

# ---------------------------------------------------------------
# Xcode
# ---------------------------------------------------------------
# Per-user window layout, breakpoints and scheme lists
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build output
build/
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.moved-aside

# Old Xcode per-user files
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Backup copies of the project
*.xcodeproj.zip

# ---------------------------------------------------------------
# Swift Package Manager
# (Package.resolved inside the .xcodeproj stays tracked, so everyone gets the same versions)
# ---------------------------------------------------------------
.build/
.swiftpm/

# ---------------------------------------------------------------
# fastlane
# ---------------------------------------------------------------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ---------------------------------------------------------------
# Python (tools/)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.env

# ---------------------------------------------------------------
# Hitchwiki data
# Dumps and intermediate files are too big for git; rebuild them with tools/.
# HitchWise/hitchwiki.sqlite is NOT ignored: the app bundles it.
# ---------------------------------------------------------------
HitchWise/hitchwiki-full-en.xml
HitchWise/hitchwiki.json
*.xml.bz2
*.xml.gz
tools/output/
tools/.venv/

# ---------------------------------------------------------------
# Editors and local tool settings
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.claude/settings.local.json

# ---------------------------------------------------------------
# Firebase CLI
# ---------------------------------------------------------------
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
